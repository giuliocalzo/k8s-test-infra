#
# Loadable Tiltfile: NVIDIA topograph consumer.
#
# Exports:
#   install(nvml_mock_releases, extra_values=[], extra_resource_deps=[])
#     — install topograph on top of the nvml-mock stack. extra_values is a
#     list of --values paths layered on top of topograph.values.yaml (later
#     paths win); extra_resource_deps adds Tilt resources topograph must wait
#     for. Both are used by --tas, which points topograph's slinky engine at
#     the Slurm cluster's slurmd pods. Returns nothing.
#
# Coupling (implicit in the root Tiltfile):
#   --topograph implies --compute-domain (cliques only exist in that
#   scenario's mock fabric, which --tas reuses with its own overlay). --dra is NOT implied: nvidia.com/gpu.clique is a static
#   Kind node label in local/kind/compute-domain.kind.yaml, so topograph
#   reads it directly from the Kubernetes API — no runtime label writer
#   required.
#
# Data path:
#   nvidia.com/gpu.clique static Kind label (per worker, set by
#   local/kind/compute-domain.kind.yaml) → topograph infiniband-k8s
#   provider reads the label → writes network.topology.nvidia.com/*
#   tier topology labels on all nodes.

load('ext://helm_resource', 'helm_resource')

_REPO_RESOURCE = 'topograph-repo'

# Pinned rather than floating, like the other consumers: an upstream release
# would otherwise change the values schema under this repo without a commit.
# Bump deliberately, and check that the block names topograph writes still
# match the seed topology.conf in local/tas/slurm.values.yaml: a mismatch
# makes every Slurm reconfigure under --tas fail.
_CHART_VERSION = '1.0.0'

def install(nvml_mock_releases, extra_values=[], extra_resource_deps=[]):
    values_flags = ['--values', 'local/topograph/topograph.values.yaml']
    for v in extra_values:
        values_flags += ['--values', v]

    helm_resource(
        'topograph',
        'topograph-repo/topograph',
        namespace='topograph',
        flags=[
            '--create-namespace',
            '--version', _CHART_VERSION,
        ] + values_flags + [
            '--timeout', '300s',
        ],
        # nvml-mock dep is for Tilt UI ordering; topograph reads from
        # the Kubernetes API (static node labels) so there is no
        # technical runtime dependency on nvml-mock.
        resource_deps=[_REPO_RESOURCE] + nvml_mock_releases + extra_resource_deps,
        labels=['topograph'],
    )
